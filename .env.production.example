# Copy to .env.production on the server (chmod 600). Never commit the real file.

# Shared secret the translator API sends in X-TTS-Key. Generate with:
#   openssl rand -base64 48
# The same value goes in Vercel as TTS_SERVICE_KEY.
TTS_SHARED_SECRET=

# CPU threads torch may use. Keep below the box's core count so other apps stay responsive.
TTS_THREADS=2

# Optional: try another checkpoint of the same model family without a code change.
# TTS_MODEL_WO=bilalfaye/speecht5_tts-wolof-v0.2
# TTS_MODEL_BM=facebook/mms-tts-bam
